data/
*.key
*.pem
jwt.key
config.json

# Docs y papers
docs/
papers/

# VSCode
.vscode/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Build artifacts
dist/
*.tar.gz
*.zip

# Local translation backup
web/src.backup/
