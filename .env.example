# ═══════════════════════════════════════════════════════════════
# NEXUS IA v6.0 — Variables de entorno
# Copia a .env y ajusta valores para tu entorno
# ═══════════════════════════════════════════════════════════════

# ─── Idioma e i18n ───
NEXUS_DEFAULT_LANG=es
NEXUS_AVAILABLE_LANGS=en,zh,hi,es,ar,fr,bn,pt,id,ru

# ─── Hardware y tier ───
NEXUS_TIER=micro
NEXUS_HARDWARE_PROFILE=config/hardware_profile.json

# ─── Ollama ───
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL_AGENTS=qwen3:4b
OLLAMA_MODEL_ETHICAL=qwen3:4b
OLLAMA_MODEL_REASONING=deepseek-r1:1.5b

# ─── LLM providers (opcionales, dejar vacío para modo 100% local) ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ─── Límites de gasto ───
MAX_DAILY_COST_USD=5

# ─── Red y puertos ───
GRPC_PORT=50051
HTTP_PORT=8080
HTTPS_PORT=8443

# ─── Base de datos ───
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nexus
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nexus

# ─── Redis ───
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Neo4j ───
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ─── Estado ───
ENV_STATE=development
LOG_LEVEL=INFO

# ─── Zero-Trust / NHI ───
MTLS_ENABLED=true
DILITHIUM_LEVEL=3
KYBER_LEVEL=768
CERT_RENEWAL_INTERVAL=24h
JWT_TTL=3600

# ─── ABM (Agent Behavior Monitor) ───
ABM_MONITOR_INTERVAL=1s
ABM_BASELINE_WINDOW=168h
ABM_IMMUTABLE_MODE=true

# ─── Ethical boundary ───
ETHICAL_ALLOW_CLOUD=false
ETHICAL_MODEL=qwen3:4b

# ─── RSI detector ───
RSI_EVAL_INTERVAL=1h
RSI_WINDOW=7d
RSI_THRESHOLD_ALERT=0.85

# ─── Adversarial RT ───
ADVERSARIAL_CYCLE_INTERVAL=48h
ADVERSARIAL_AUTO_PATCH=true

# ─── Governance ───
GOVERNANCE_REPORT_INTERVAL=168h
GOVERNANCE_FORMATS=pdf,stix21,json
GOVERNANCE_SIGN_ALG=DILITHIUM3