# ═══════════════════════════════════════════════════════════════
# NEXUS IA v6.0 — Variables de entorno
# Copia a .env y ajusta valores para tu entorno
# ═══════════════════════════════════════════════════════════════

# ─── Idioma e i18n ───
NEXUS_DEFAULT_LANG=es
NEXUS_AVAILABLE_LANGS=en,zh,hi,es,ar,fr,bn,pt,id,ru

# ─── Hardware y tier ───
NEXUS_TIER=micro
NEXUS_HARDWARE_PROFILE=config/hardware_profile.json

# ─── Ollama ───
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL_AGENTS=qwen3:4b
OLLAMA_MODEL_ETHICAL=qwen3:4b
OLLAMA_MODEL_REASONING=deepseek-r1:1.5b

# ─── LLM providers (opcionales, dejar vacío para modo 100% local) ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ─── Límites de gasto ───
MAX_DAILY_COST_USD=5

# ─── Red y puertos ───
GRPC_PORT=50051
HTTP_PORT=8080
HTTPS_PORT=8443

# ─── Base de datos ───
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nexus
# OBLIGATORIO: sin valor el stack no arranca. Genera una larga y aleatoria,
# p. ej.: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=nexus

# ─── Copias de seguridad (servicio "backup") ───
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24
# Aviso a NEXUS_OPS_EMAIL si la última copia supera esta antigüedad (horas).
BACKUP_MAX_AGE_HOURS=26

# ─── Portal de clientes ───
# URL pública del portal y de la consola (los enlaces de los emails la usan).
NEXUS_PORTAL_BASE_URL=
NEXUS_CONSOLE_BASE_URL=
# Correo saliente. Sin NEXUS_SMTP_HOST los emails solo se escriben en el log.
NEXUS_SMTP_HOST=
NEXUS_SMTP_PORT=587
NEXUS_SMTP_USER=
NEXUS_SMTP_PASS=
NEXUS_SMTP_FROM=NEXUS Cybersecurity Global <no-reply@tu-dominio>
# Buzón del equipo NEXUS para avisos internos (verificaciones solicitadas).
NEXUS_OPS_EMAIL=
# La API escucha en 127.0.0.1 (detrás de un proxy HTTPS). 0.0.0.0 solo para pruebas.
NEXUS_BIND=127.0.0.1

# ─── HTTPS (make up-https) ───
# Dominio público; debe apuntar a este servidor (puertos 80 y 443 abiertos).
# Pon también NEXUS_PORTAL_BASE_URL=https://<dominio>/portal.
NEXUS_DOMAIN=
# Red del proxy y su IP: el backend solo acepta la IP real del cliente
# (X-Forwarded-For) cuando la petición llega desde NEXUS_PROXY_IP. Cámbialas
# solo si la subred choca con otra de tu servidor.
NEXUS_EDGE_SUBNET=172.29.80.0/24
NEXUS_PROXY_IP=172.29.80.10

# ─── Redis ───
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Neo4j ───
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ─── Estado ───
ENV_STATE=development
LOG_LEVEL=INFO

# ─── Zero-Trust / NHI ───
MTLS_ENABLED=true
DILITHIUM_LEVEL=3
KYBER_LEVEL=768
CERT_RENEWAL_INTERVAL=24h
JWT_TTL=3600

# ─── ABM (Agent Behavior Monitor) ───
ABM_MONITOR_INTERVAL=1s
ABM_BASELINE_WINDOW=168h
ABM_IMMUTABLE_MODE=true

# ─── Ethical boundary ───
ETHICAL_ALLOW_CLOUD=false
ETHICAL_MODEL=qwen3:4b

# ─── RSI detector ───
RSI_EVAL_INTERVAL=1h
RSI_WINDOW=7d
RSI_THRESHOLD_ALERT=0.85

# ─── Adversarial RT ───
ADVERSARIAL_CYCLE_INTERVAL=48h
ADVERSARIAL_AUTO_PATCH=true

# ─── Governance ───
GOVERNANCE_REPORT_INTERVAL=168h
GOVERNANCE_FORMATS=pdf,stix21,json
GOVERNANCE_SIGN_ALG=DILITHIUM3