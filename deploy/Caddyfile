# HTTPS de NEXUS (servicio "https" de docker-compose.yml).
#
# Caddy obtiene y renueva solo el certificado de NEXUS_DOMAIN (Let's Encrypt;
# el dominio debe apuntar a este servidor y los puertos 80/443 estar abiertos),
# redirige HTTP a HTTPS y reenvía todo al backend. El backend confía en la
# dirección del cliente que Caddy le pasa (X-Forwarded-For) solo porque llega
# desde NEXUS_PROXY_IP (NEXUS_TRUSTED_PROXIES). Con NEXUS_DOMAIN=localhost usa
# un certificado local, útil para probar.

{$NEXUS_DOMAIN} {
	encode zstd gzip

	header {
		# El navegador solo volverá a entrar por HTTPS (1 año).
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Las métricas son solo para la red interna (127.0.0.1:8787/api/metrics).
	respond /api/metrics 404

	reverse_proxy orchestrator:8787 {
		# Sin búfer: los eventos en vivo (SSE) llegan al momento.
		flush_interval -1
	}
}
